# Шаблон переменных окружения для приложения Deutch Test

# Пароль для доступа в панель администратора (/admin.html)
ADMIN_PASSWORD=

# URL базы данных SQLite/Prisma (по умолчанию: file:./prisma/dev.db)
DATABASE_URL=

# Секретный ключ для подписи сессионных cookie
SESSION_SECRET=
